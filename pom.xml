<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.thevpc.skeleton</groupId>
    <artifactId>skeleton-module-root</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Skeleton Module :: Root</name>
    <description>Reusable Pyramid Architecture backend template with optional adapter slots</description>

    <properties>
        <!-- Java Configuration -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot -->
        <spring.boot.version>3.3.5</spring.boot.version>

        <!-- NAF (Nuts Application Framework) -->
        <nuts.version>1.1.0</nuts.version>
        <nuts-spring-boot.version>1.1.0.0</nuts-spring-boot.version>

        <!-- Resilience4j for Circuit Breaking & Retries -->
        <resilience4j.version>2.2.0</resilience4j.version>

        <!-- Testing -->
        <archunit.version>1.3.0</archunit.version>

        <!-- Utilities -->
        <lombok.version>1.18.38</lombok.version>

        <!-- API Documentation -->
        <springdoc.version>2.6.0</springdoc.version>

    </properties>

    <modules>
        <module>infra</module>
        <module>dal-api</module>
        <module>dal-jpa</module>
        <module>dal-mongodb</module>
        <module>dal-messaging</module>
        <module>service-api</module>
        <module>service-impl</module>
        <module>service-rest-cli</module>
        <module>service-grpc-cli</module>
        <module>ws-rest</module>
        <module>ws-grpc</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j BOM -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Module Dependencies -->
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-dal-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-dal-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-dal-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-dal-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-service-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-service-rest-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-service-grpc-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-ws-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.skeleton</groupId>
                <artifactId>skeleton-module-ws-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- NAF (Nuts Application Framework) -->
            <dependency>
                <groupId>net.thevpc.nuts</groupId>
                <artifactId>nuts</artifactId>
                <version>${nuts.version}</version>
            </dependency>
            <dependency>
                <groupId>net.thevpc.nuts</groupId>
                <artifactId>nuts-spring-boot</artifactId>
                <version>${nuts-spring-boot.version}</version>
            </dependency>

            <!-- Utilities -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- API Documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Architecture Testing -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Logging (provided by Spring Boot) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
